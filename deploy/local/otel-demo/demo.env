# Public local-development overrides for the verified OpenTelemetry Demo checkout.
# Load after the upstream .env. Do not load the sibling .env.override.
IMAGE_NAME=ghcr.io/open-telemetry/demo
DEMO_VERSION=3.1.0
IMAGE_VERSION=3.1.0
OTEL_SERVICE_NAMESPACE=opentelemetry-demo
OTEL_RESOURCE_ATTRIBUTES=service.namespace=opentelemetry-demo,service.version=3.1.0
